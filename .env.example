# Mail settings for a MANUAL (development) run: copy this file to .env, or set
# these as real environment variables, and fill in real values. Never commit a
# filled-in version of this file.
#
# As a systemd service the environment is not used: the same five KEY=VALUE
# lines come from the systemd credential "smtp" ($CREDENTIALS_DIRECTORY/smtp),
# with values taken literally (no quotes) - see README, "Running as a service".

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=you@example.com
